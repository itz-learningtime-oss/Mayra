# MYRA - Environment Variables Template
# Copy this file to `.env` and fill in real values locally.
# NEVER commit the `.env` file or real secret values to the repository.

# --- Firebase / Google ---
# Replace these in res/values/strings.xml with your own Firebase project values
# (never hardcode real values in committed source):
GOOGLE_API_KEY=
GOOGLE_APP_ID=
GOOGLE_CRASH_REPORTING_API_KEY=
GOOGLE_STORAGE_BUCKET=
GCM_DEFAULT_SENDER_ID=
FIREBASE_PROJECT_ID=

# --- LLM API keys (user-provided at runtime, stored in SharedPreferences) ---
# These are entered by the user inside the app settings. If you hardcode them
# for testing, do NOT commit the values.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Payments ---
# Razorpay and Google Play Billing keys are configured in your app dashboard,
# not in this repo. Keep publishable/test keys in test only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Supabase (if used) ---
# The anon key is safe client-side ONLY if Row Level Security (RLS) is enabled
# on every table. The service_role key must NEVER appear in client-side code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Backend (if any) ---
BACKEND_API_URL=
JWT_SIGNING_SECRET=